{
  "name": "spar-agent",
  "version": "0.4.3",
  "description": "Keep learning while AI writes the code. Predict before you're told, and turn every gap between your model and reality into a curriculum.",
  "keywords": [
    "agent-skills",
    "claude-code",
    "cursor",
    "learning",
    "hooks",
    "deliberate-practice"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "spar": "dist/cli.js"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "com.anthropic.claude-code",
    "com.cursor",
    "dist",
    "hooks",
    "mcp.json",
    "plugin.json",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "emit": "node dist/cli.js emit --root .",
    "prepublishOnly": "npm run build && npm test",
    "validate:example": "npm run build && bash scripts/validate-example.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lander-Parren/spar.git"
  },
  "homepage": "https://github.com/Lander-Parren/spar#readme",
  "bugs": {
    "url": "https://github.com/Lander-Parren/spar/issues"
  },
  "author": "Lander Parren"
}
